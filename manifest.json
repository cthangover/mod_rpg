{
  "id": "rpg",
  "name": "RPG World",
  "version": "0.1.0",
  "author": "ct",
  "description": "A walkable tile world in the spirit of RPG Maker: grid movement with WASD, events on E/F, teleports; a map is an ordinary scene of the game. Battles and random encounters come with turn_battle_base through the battles integration, so the world runs without it.",
  "category": "gameplay",
  "sources": [
    "src/**/*.cs"
  ],
  "test_sources": [
    "tests/*.cs"
  ],
  "depends": [
    "shell2d_base>=0.1.0",
    "ui_base>=0.1.0",
    "time_base>=0.1.0",
    "dialog_base>=0.1.0",
    "characters_base>=0.1.0",
    "tile_render_base>=0.1.0"
  ],
  "integrations": [
    { "id": "battles", "with": [ "turn_battle_base" ] }
  ],
  "test_suites": [
    {
      "id": "walk",
      "activate": [
        "--itest=rpg_walk"
      ]
    },
    {
      "id": "render",
      "activate": [
        "--itest=tile_render"
      ]
    },
    {
      "id": "snapshots",
      "activate": [
        "--itest=rpg_snapshots"
      ]
    },
    {
      "id": "plain_walk",
      "activate": [
        "--itest=rpg_plain_walk"
      ]
    },
    {
      "id": "party_walk",
      "activate": [
        "--itest=rpg_party_walk"
      ]
    }
  ]
}
