{
  "id": "rpg",
  "name": "RPG World",
  "version": "0.1.0",
  "author": "ct",
  "description": "A walkable tile world with keyboard and optional cardinal click movement, interactions and map scenes. Battles and encounters are supplied by an optional integration.",
  "categories": [
    "gameplay"
  ],
  "sources": [
    "src/**/*.cs"
  ],
  "test_sources": [
    "tests/*.cs"
  ],
  "depends": [
    "shell2d_base>=0.1.0",
    "ui_base>=0.1.0",
    "time_base>=0.1.0",
    "dialog_base>=0.1.0",
    "characters_base>=0.1.0",
    "tile_render_base>=0.1.0"
  ],
  "integrations": [
    {
      "id": "ground_rewards",
      "path": "ground_rewards",
      "with": [
        "items_base"
      ]
    },
    {
      "id": "battles",
      "with": [
        "turn_battle_base"
      ]
    }
  ],
  "test_suites": [
    {
      "id": "walk",
      "activate": [
        "--itest=rpg_walk"
      ]
    },
    {
      "id": "render",
      "activate": [
        "--itest=tile_render"
      ]
    },
    {
      "id": "snapshots",
      "activate": [
        "--itest=rpg_snapshots"
      ]
    },
    {
      "id": "plain_walk",
      "activate": [
        "--itest=rpg_plain_walk"
      ]
    },
    {
      "id": "party_walk",
      "activate": [
        "--itest=rpg_party_walk"
      ]
    },
    {
      "id": "click_walk",
      "activate": [
        "--itest=rpg_click_walk"
      ]
    }
  ]
}
