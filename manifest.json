{
  "id": "rpg",
  "name": "RPG World",
  "version": "1.0.0",
  "author": "ct",
  "description": "A walkable tile world in the spirit of RPG Maker: grid movement with WASD, events on E/F, teleports, random encounters; a map is an ordinary scene of the game.",
  "category": "gameplay",
  "sources": [
    "src/**/*.cs"
  ],
  "test_sources": [
    "tests/*.cs"
  ],
  "depends": [
    "shell2d_base>=1",
    "ui_base>=1",
    "time_base>=1",
    "dialog_base>=1",
    "turn_battle_base>=2",
    "tile_render_base>=1"
  ],
  "test_suites": [
    {
      "id": "walk",
      "activate": [
        "--itest=rpg_walk"
      ]
    },
    {
      "id": "render",
      "activate": [
        "--itest=tile_render"
      ]
    }
  ]
}
